<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SkillBaseTool</RootNamespace>
    <AssemblyName>SkillBaseTool</AssemblyName>
    <ApplicationIcon>SkillBaseTool.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="SkillBaseTool.ico" LogicalName="SkillBaseTool.SkillBaseTool.ico" />
  </ItemGroup>

</Project>
